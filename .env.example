# ==========================================================================
# Telegram API credentials  ->  get from https://my.telegram.org  (API development tools)
# The SAME api_id / api_hash is used by BOTH the bot and the userbot.
# ==========================================================================
API_ID=1234567
API_HASH=your_api_hash_here

# ==========================================================================
# BOT  ->  token from @BotFather
# The bot MUST be an ADMIN in the SOURCE channel with the "Add users" /
# "Invite via link" right. That admin right is what lets it DM requesters.
# ==========================================================================
BOT_TOKEN=123456:ABC-DEF_your_bot_token

# ==========================================================================
# OWNER = the ONLY account allowed to run /broadcast on the bot.
# This is your numeric Telegram user id. `python setup.py` fills it in for you
# automatically after the userbot login; set it by hand only if not using setup.
# ==========================================================================
OWNER_ID=123456789

# ==========================================================================
# SOURCE channel = the one that already collected the 2k+ join requests.
# Use its @username, OR its numeric id (looks like -1001234567890),
# OR a private invite link. The userbot account must be an ADMIN here too.
# ==========================================================================
SOURCE_CHANNEL=@your_source_channel

# ==========================================================================
# The message that gets DM'd to every requester.
# {name} is replaced with the user's first name (falls back to "there").
# Use \n for line breaks. Keep it short and human.
# ==========================================================================
NEW_CHANNEL_LINK=https://t.me/+xxxxxxxxxxxx
DM_MESSAGE=Hey {name}! Thanks for requesting to join.\nWe've moved to a new channel — join here: {link}

# ==========================================================================
# Rate limiting for the backlog DM run (be gentle to avoid spam flags).
# Seconds to sleep between each DM, plus a longer pause every N messages.
# ==========================================================================
DM_DELAY_SECONDS=4
BATCH_SIZE=25
BATCH_PAUSE_SECONDS=60
