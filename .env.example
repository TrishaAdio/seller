# ==========================================================================
# Telegram API credentials  ->  get from https://my.telegram.org
# (API development tools). Telethon needs these even for a bot login.
# ==========================================================================
API_ID=1234567
API_HASH=your_api_hash_here

# ==========================================================================
# BOT  ->  token from @BotFather
# The bot MUST be an ADMIN in every watched channel with the "Add users" /
# "Invite via link" right. That admin right is what lets it DM requesters.
# ==========================================================================
BOT_TOKEN=123456:ABC-DEF_your_bot_token

# ==========================================================================
# OWNER = the ONLY account the bot takes commands from.
# Your numeric Telegram user id (ask @userinfobot if you don't know it).
# ==========================================================================
OWNER_ID=123456789

# ==========================================================================
# Channels are NOT configured here — add them at runtime from the bot:
#   /add -1001234567890     /remove -1001234567890     /chats
# ==========================================================================

# ==========================================================================
# Rate limiting for broadcasts (be gentle to avoid spam flags).
# Seconds to sleep between each send, plus a longer pause every N messages.
# ==========================================================================
DM_DELAY_SECONDS=4
BATCH_SIZE=25
BATCH_PAUSE_SECONDS=60
